<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.rajkotmarket.erp.ui.ConnectionController"
      styleClass="connection-pane" spacing="14" alignment="TOP_CENTER">
    <padding><Insets top="36" right="48" bottom="36" left="48"/></padding>

    <Label text="RajkotMarket ERP" styleClass="brand-title"/>
    <Label text="Connect to your Supabase PostgreSQL database" styleClass="subtitle"/>

    <GridPane hgap="10" vgap="12" maxWidth="430">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Host" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="hostField" promptText="aws-0-xxxx.pooler.supabase.com"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Port" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="portField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Database" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="databaseField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="User" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="userField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Password" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" promptText="database password"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Button fx:id="connectButton" text="Test &amp; Connect" defaultButton="true"
            onAction="#onConnect" styleClass="primary-button"/>
    <Label fx:id="statusLabel" wrapText="true" maxWidth="430" styleClass="status-info"/>

    <Label wrapText="true" maxWidth="430" styleClass="hint"
           text="Find these in the Supabase dashboard → Connect → JDBC (use the &quot;Transaction pooler&quot;, port 6543). The host, user and database are pre-filled for the pooler; paste your database password."/>
</VBox>
